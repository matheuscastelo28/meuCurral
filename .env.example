# Chave de conexão do PostgreSQL (as tabelas são criadas sozinhas na primeira consulta).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/meucurral

# E-mail transacional (código de verificação de cadastro), via Resend — https://resend.com
# Sem essas duas variáveis, em desenvolvimento o código só aparece no log do
# servidor (nunca é enviado). Em produção elas são obrigatórias.
RESEND_API_KEY=
EMAIL_FROM="Meu Curral Digital <nao-responda@seudominio.com.br>"
